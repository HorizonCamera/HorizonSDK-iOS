{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK"]]},"identifier":{"url":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/Installation","interfaceLanguage":"occ"},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"HorizonSDK"}],"title":"Installation"},"abstract":[{"type":"text","text":"Add Horizon SDK to an iOS app."}],"sections":[],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Horizon SDK supports iOS 15 and later, on devices and the Simulator (which has no camera, so"},{"type":"text","text":" "},{"type":"text","text":"capture calls report that the camera is not running)."}]},{"anchor":"Swift-Package-Manager","level":3,"type":"heading","text":"Swift Package Manager"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, choose File › Add Package Dependencies, enter"},{"type":"text","text":" "},{"type":"codeVoice","code":"https:\/\/github.com\/HorizonCamera\/HorizonSDK-iOS"},{"type":"text","text":", then add the "},{"type":"codeVoice","code":"HorizonSDK"},{"type":"text","text":" library to your app"},{"type":"text","text":" "},{"type":"text","text":"target."}]},{"anchor":"CocoaPods","level":3,"type":"heading","text":"CocoaPods"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"pod 'HorizonSDK', '~> 3.0'"},{"type":"text","text":" to your Podfile and run "},{"type":"codeVoice","code":"pod install"},{"type":"text","text":". CocoaPods trunk stops"},{"type":"text","text":" "},{"type":"text","text":"accepting new versions on December 2, 2026; later releases ship through Swift Package Manager only."}]},{"anchor":"XCFramework","level":3,"type":"heading","text":"XCFramework"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Drag "},{"type":"codeVoice","code":"HorizonSDK.xcframework"},{"type":"text","text":" into your project and set it to "},{"inlineContent":[{"text":"Embed & Sign","type":"text"}],"type":"strong"},{"type":"text","text":" in your target’s"},{"type":"text","text":" "},{"type":"text","text":"Frameworks, Libraries, and Embedded Content. The framework carries its own resources (interface"},{"type":"text","text":" "},{"type":"text","text":"files, images, Metal library and privacy manifest); nothing else needs to be copied."}]},{"anchor":"Permissions","level":3,"type":"heading","text":"Permissions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"NSCameraUsageDescription"},{"type":"text","text":" and, to record sound, "},{"type":"codeVoice","code":"NSMicrophoneUsageDescription"},{"type":"text","text":" to your app’s"},{"type":"text","text":" "},{"type":"text","text":"Info.plist, and request access with "},{"type":"codeVoice","code":"AVCaptureDevice"},{"type":"text","text":" before starting the camera."}]},{"anchor":"Activation","level":3,"type":"heading","text":"Activation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Activate the SDK with your API key once, at launch, before creating an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera"},{"type":"text","text":":"}]},{"syntax":"objc","code":["@import HorizonSDK;","","- (BOOL)application:(UIApplication *)application didFinishLaunchingWithOptions:(NSDictionary *)launchOptions","{","    NSError *error = nil;","","    if (![[HVTSDK sharedInstance] activateWithAPIKey:@\"YOUR_API_KEY\" error:&error]) {","        NSLog(@\"Horizon SDK activation failed: %@\", error.localizedDescription);","    }","","    return YES;","}"],"type":"codeListing"},{"syntax":"swift","code":["do {","    try HVTSDK.sharedInstance().activate(withAPIKey: \"YOUR_API_KEY\")","} catch {","    print(\"Horizon SDK activation failed: \\(error)\")","}"],"type":"codeListing"}]}],"seeAlsoSections":[{"generated":true,"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/QuickStart","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTSDK"]}],"variants":[{"paths":["\/documentation\/horizonsdk\/installation"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK":{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","role":"collection","abstract":[{"text":"Record leveled video and take leveled photos: horizontal no matter how the device is held.","type":"text"}],"type":"topic","title":"HorizonSDK","url":"\/documentation\/horizonsdk","kind":"symbol"},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTSDK":{"abstract":[{"type":"text","text":"The base class of Horizon SDK"}],"kind":"symbol","title":"HVTSDK","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTSDK","url":"\/documentation\/horizonsdk\/hvtsdk","type":"topic","fragments":[{"text":"HVTSDK","kind":"identifier"}],"role":"symbol"},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCamera":{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera","kind":"symbol","title":"HVTCamera","abstract":[{"text":"You can use a HVTCamera object to establish a connection with the device camera, update the attached preview(s)","type":"text"},{"text":" ","type":"text"},{"text":"and record to an audio\/video container file.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/horizonsdk\/hvtcamera","fragments":[{"kind":"identifier","text":"HVTCamera"}]},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/QuickStart":{"abstract":[{"type":"text","text":"Record your first leveled video."}],"kind":"article","title":"Quick Start","identifier":"doc:\/\/com.hvt.horizonsdk.framewor