{"kind":"article","abstract":[{"type":"text","text":"Add Horizon SDK to an iOS app."}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/QuickStart","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTSDK"],"anchor":"Essentials","title":"Essentials","generated":true}],"metadata":{"roleHeading":"Article","modules":[{"name":"HorizonSDK"}],"role":"article","title":"Installation"},"identifier":{"url":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/Installation","interfaceLanguage":"occ"},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Horizon SDK supports iOS 15 and later, on devices and the Simulator (which has no camera, so"},{"type":"text","text":" "},{"type":"text","text":"capture calls report that the camera is not running)."}]},{"type":"heading","text":"Swift Package Manager","anchor":"Swift-Package-Manager","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode, choose File › Add Package Dependencies, enter"},{"type":"text","text":" "},{"type":"codeVoice","code":"https:\/\/github.com\/HorizonCamera\/HorizonSDK-iOS"},{"type":"text","text":", then add the "},{"type":"codeVoice","code":"HorizonSDK"},{"type":"text","text":" library to your app"},{"type":"text","text":" "},{"type":"text","text":"target."}]},{"type":"heading","text":"CocoaPods","anchor":"CocoaPods","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"pod 'HorizonSDK', '~> 3.0'"},{"type":"text","text":" to your Podfile and run "},{"type":"codeVoice","code":"pod install"},{"type":"text","text":". CocoaPods trunk stops"},{"type":"text","text":" "},{"type":"text","text":"accepting new versions on December 2, 2026; later releases ship through Swift Package Manager only."}]},{"type":"heading","text":"XCFramework","anchor":"XCFramework","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Drag "},{"type":"codeVoice","code":"HorizonSDK.xcframework"},{"type":"text","text":" into your project and set it to "},{"inlineContent":[{"text":"Embed & Sign","type":"text"}],"type":"strong"},{"type":"text","text":" in your target’s"},{"type":"text","text":" "},{"type":"text","text":"Frameworks, Libraries, and Embedded Content. The framework carries its own resources (interface"},{"type":"text","text":" "},{"type":"text","text":"files, images, Metal library and privacy manifest); nothing else needs to be copied."}]},{"type":"heading","text":"Permissions","anchor":"Permissions","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"NSCameraUsageDescription"},{"type":"text","text":" and, to record sound, "},{"type":"codeVoice","code":"NSMicrophoneUsageDescription"},{"type":"text","text":" to your app’s"},{"type":"text","text":" "},{"type":"text","text":"Info.plist, and request access with "},{"type":"codeVoice","code":"AVCaptureDevice"},{"type":"text","text":" before starting the camera."}]},{"type":"heading","text":"Activation","anchor":"Activation","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Activate the SDK with your API key once, at launch, before creating an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera"},{"type":"text","text":":"}]},{"type":"codeListing","code":["@import HorizonSDK;","","- (BOOL)application:(UIApplication *)application didFinishLaunchingWithOptions:(NSDictionary *)launchOptions","{","    NSError *error = nil;","","    if (![[HVTSDK sharedInstance] activateWithAPIKey:@\"YOUR_API_KEY\" error:&error]) {","        NSLog(@\"Horizon SDK activation failed: %@\", error.localizedDescription);","    }","","    return YES;","}"],"syntax":"objc"},{"type":"codeListing","code":["do {","    try HVTSDK.sharedInstance().activate(withAPIKey: \"YOUR_API_KEY\")","} catch {","    print(\"Horizon SDK activation failed: \\(error)\")","}"],"syntax":"swift"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/horizonsdk\/installation"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK"]]},"references":{"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTSDK":{"role":"symbol","abstract":[{"type":"text","text":"The base class of Horizon SDK"}],"kind":"symbol","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTSDK","fragments":[{"kind":"identifier","text":"HVTSDK"}],"title":"HVTSDK","url":"\/documentation\/horizonsdk\/hvtsdk","type":"topic"},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/QuickStart":{"url":"\/documentation\/horizonsdk\/quickstart","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/QuickStart","title":"Quick Start","type":"topic","kind":"article","abstract":[{"text":"Record your first leveled video.","type":"text"}],"role":"article"},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK":{"url":"\/documentation\/horizonsdk","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","type":"topic","role":"collection","abstract":[{"type":"text","text":"Record leveled video and take leveled photos: horizontal no matter how the device is held."}],"title":"HorizonSDK","kind":"symbol"},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCamera":{"url":"\/documentation\/horizonsdk\/hvtcamera","role":"symbol","abstract":[{"type":"text","text":"You can use a HVTCamera object to establish a connection with the device camera, update the attached preview(s)"},{"type":"text","text":" "},{"type":"text","text":"and record to an audio\/video container file."}],"title":"HVTCamera","fragments":[{"kind":"identifier","text":"HVTCamera"}]