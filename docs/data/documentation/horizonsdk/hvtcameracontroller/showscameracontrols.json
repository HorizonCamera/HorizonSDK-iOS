{"kind":"symbol","abstract":[{"type":"text","text":"Indicates whether the camera controller displays the default camera controls."}],"metadata":{"modules":[{"name":"HorizonSDK"}],"navigatorTitle":[{"kind":"identifier","text":"showsCameraControls"}],"roleHeading":"Instance Property","role":"symbol","symbolKind":"property","fragments":[{"text":"showsCameraControls","kind":"identifier"}],"title":"showsCameraControls","externalID":"c:objc(cs)HVTCameraController(py)showsCameraControls"},"identifier":{"url":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraController\/showsCameraControls","interfaceLanguage":"occ"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":") ","kind":"text"},{"preciseIdentifier":"c:@T@BOOL","kind":"typeIdentifier","text":"BOOL"},{"kind":"text","text":" "},{"kind":"identifier","text":"showsCameraControls"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default value of this property is YES, which specifies that the default camera controls are visible in the camera controller. Set it to NO to hide the default controls if you want to instead provide a custom overlay view using the cameraOverlayView property."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/horizonsdk\/hvtcameracontroller\/showscameracontrols"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraController"]]},"references":{"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK":{"url":"\/documentatio