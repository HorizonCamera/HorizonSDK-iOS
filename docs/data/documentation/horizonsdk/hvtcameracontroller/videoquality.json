":"identifier","text":"HVTCameraController"}],"url":"\/documentation\/horizonsdk\/hvtcameracontroller","kind":"symbol","role":"symbol","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraController","title":"HVTCameraController","abstract":[{"text":"The HVTCameraController operates exactly as the UIImagePickerController class of UIKit.","type":"text"},{"text":" ","type":"text"},{"text":"It manages customizable, system-supplied user interfaces for taking pictures and movies on supported devices for use in your app. A camera controller manages user interactions and delivers the results of those interactions to a delegate object.","type":"text"}],"type":"topic"}}}