{"hierarchy":{"paths":[["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraController"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraController\/mediaTypes"},"metadata":{"fragments":[{"text":"mediaTypes","kind":"identifier"}],"modules":[{"name":"HorizonSDK"}],"platforms":[{"deprecatedAt":"15.0","deprecated":false,"beta":false,"introducedAt":"8.0","unavailable":false,"name":"iOS"},{"deprecatedAt":"15.0","deprecated":false,"beta":false,"introducedAt":"8.0","unavailable":false,"name":"iPadOS"},{"deprecatedAt":"15.0","deprecated":false,"beta":false,"introducedAt":"8.0","unavailable":false,"name":"Mac Catalyst"}],"roleHeading":"Instance Property","externalID":"c:objc(cs)HVTCameraController(py)mediaTypes","role":"symbol","title":"mediaTypes","symbolKind":"property","navigatorTitle":[{"text":"mediaTypes","kind":"identifier"}]},"abstract":[{"type":"text","text":"An array indicating the media types to be accessed by the media picker controller."}],"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"copy"},{"kind":"text","text":") "},{"kind":"typeIdentifier","preciseIdentifier":"c:Q$objc(cs)NSArray","text":"NSArray<NSString *>"},{"kind":"text","text":" * "},{"kind":"identifier","text":"mediaTypes"},{"kind":"text","text":";"}],"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Depending on the media types you assign to this property, the camera controller displays a dedicated interface for still images or movies, or a selection control that lets the user choose the camera interface. Before setting this property, check which media types are available by calling the availableMediaTypesForSourceType: class method."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you set this property to an empty array, or to an array in which none of the media types is available for the current source, the system throws an exception."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default, this property is set to the single value UTTypeImage.identifier, which designates the still camera interface."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Superseded by allowedContentTypes, which holds the same setting as UTType values."}]}]}],"variants":[{"paths":["\/documentation\/horizonsdk\/hvtcameracontroller\/mediatypes"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK":{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","role":"collection","abstract":[{"text":"Record leveled video and take leveled photos: horizontal no matter how the device is held.","type":"text"}],"type":"topic","title":"HorizonSDK","url":"\/documentation\/horizonsdk","kind":"symbol"},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCameraController/mediaTypes":{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraController\/mediaTypes","kind":"symbol","title":"mediaTypes","deprecated":true,"abstract":[{"type":"text","text":"An array indicating the media types to be accessed by the media picker controller."}],"type":"topic","role":"symbol","url":"\/documentation\/horizonsdk\/hvtcameracontroller\/mediatypes","fragments":[{"text":"mediaTypes","kind":"identifier"}]},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCameraController":{"fragments":[{"kind":"identifier","text":"HVTCameraController"}],"url":"\/documentation\/horizonsdk\/hvtcameracontroller","kind":"symbol","role":"symbol","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraController","title":"HVTCameraController","abstract":[{"text":"The HVTCameraController operates exactly as the UIImagePickerController class of UIKit.","type":"text"},{"text":" ","type":"text"},{"text":"It manages customizable, system-supplied user interfaces for taking pictures and movies on supported devices for use in your app. A camera controller manages user interactions and delivers the results of those interactions to a delegate object.","type":"text"}],"type":"topic"}}}