{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraController"]]},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraController\/cameraOverlayView"},"metadata":{"fragments":[{"kind":"identifier","text":"cameraOverlayView"}],"modules":[{"name":"HorizonSDK"}],"roleHeading":"Instance Property","externalID":"c:objc(cs)HVTCameraController(py)cameraOverlayView","role":"symbol","title":"cameraOverlayView","symbolKind":"property","navigatorTitle":[{"text":"cameraOverlayView","kind":"identifier"}]},"abstract":[{"text":"The view to display on top of the default image picker interface.","type":"text"}],"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["occ"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":", "},{"kind":"keyword","text":"strong"},{"kind":"text","text":", "},{"kind":"keyword","text":"nullable"},{"kind":"text","text":") "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)UIView","text":"UIView"},{"kind":"text","text":" * "},{"kind":"identifier","text":"cameraOverlayView"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use an overlay view to present a custom view hierarchy on top of the default camera interface. The camera controller layers your custom overlay view on top of the other views and positions it relative to the screen coordinates. If you have the default camera controls set to be visible, incorporate transparency into your view, or position it to avoid obscuring the underlying content."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/horizonsdk\/hvtcameracontroller\/cameraoverlayview"]}],"references":{"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCameraController":{"fragments":[{"kind":"identifier","text":"HVTCameraController"}],"url":"\/documentation\/horizonsdk\/hvtcameracontroller","kind":"symbol","role":"symbol","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraController","title":"HVTCameraController","abstract":[{"text":"The HVTCameraController operates exactly as the UIImagePickerController class of UIKit.","type":"text"},{"text":" ","type":"text"},{"text":"It manages customizable, system-supplied user interfaces for taking pictures and movies on supported devices for use in your app. A camera controller manages user interactions and delivers the results of those interactions to a delegate object.","type":"text"}],"type":"topic"},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCameraController/cameraOverlayView":{"fragments":[{"text":"cameraOverlayView","kind":"identifier"}],"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraController\/cameraOverlayView","abstract":[{"text":"The view to display on top of the default image picker interface.","type":"text"}],"title":"cameraOverlayView","kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/horizonsdk\/hvtcameracontroller\/cameraoverlayview"},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK":{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","role":"collection","abstract":[{"text":"Record leveled video and take leveled photos: horizontal no matter how the device is held.","type":"text"}],"type":"topic","title":"HorizonSDK","url":"\/documentation\/horizonsdk","kind":"symbol"}}}