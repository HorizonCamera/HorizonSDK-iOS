{"relationshipsSections":[{"identifiers":["doc:\/\/com.hvt.horizonsdk.framework\/objc(cs)UIViewController"],"title":"Inherits From","type":"inheritsFrom","kind":"relationships"}],"kind":"symbol","abstract":[{"type":"text","text":"The HVTCameraController operates exactly as the UIImagePickerController class of UIKit."},{"type":"text","text":" "},{"type":"text","text":"It manages customizable, system-supplied user interfaces for taking pictures and movies on supported devices for use in your app. A camera controller manages user interactions and delivers the results of those interactions to a delegate object."}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraControllerDelegate"],"anchor":"Ready-made-interface","title":"Ready-made interface","generated":true}],"metadata":{"modules":[{"name":"HorizonSDK"}],"navigatorTitle":[{"kind":"identifier","text":"HVTCameraController"}],"roleHeading":"Class","role":"symbol","symbolKind":"class","fragments":[{"kind":"identifier","text":"HVTCameraController"}],"title":"HVTCameraController","externalID":"c:objc(cs)HVTCameraController"},"identifier":{"url":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraController","interfaceLanguage":"occ"},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"kind":"keyword","text":"@interface"},{"kind":"text","text":" "},{"kind":"identifier","text":"HVTCameraController"},{"kind":"text","text":" : "},{"preciseIdentifier":"c:objc(cs)UIViewController","kind":"typeIdentifier","text":"UIViewController"}]}],"kind":"declarations"},{"mentions":["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/QuickStart"],"kind":"mentions"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The role and appearance of the camera controller depend on the source type you assign to it before you present it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use the camera controller containing its default controls, perform these steps:"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Check which media types are available for the source type you’re using, by calling the availableMediaTypesForSourceType: class method. This lets you distinguish between a camera that can be used for video recording and one that can be used only for still images."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tell the image picker controller to adjust the UI according to the media types you want to make available—still images, movies, or both—by setting the mediaTypes property."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Present the user interface by calling the presentViewController:animated:completion: method of the currently active view controller, passing your configured camera controller as the new view controller."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the user taps a button to pick a newly-captured or saved image or movie, or cancels the operation, dismiss the image picker using your delegate object. Your delegate can then save it to the Camera Roll on the device."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can customize an image picker controller to manage user interactions yourself. To do this, provide an overlay view containing the controls you want to display. You can display your custom overlay view in addition to, or instead of, the default controls."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/horizonsdk\/hvtcameracontroller"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK"]]},"topicSections":[{"identifiers":["doc:\/\/com.hvt.horizonsdk.framework\/documentation