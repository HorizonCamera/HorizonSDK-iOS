{"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera"]]},"identifier":{"url":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera\/levelerCropMode","interfaceLanguage":"occ"},"metadata":{"externalID":"c:objc(cs)HVTCamera(py)levelerCropMode","roleHeading":"Instance Property","symbolKind":"property","title":"levelerCropMode","modules":[{"name":"HorizonSDK"}],"navigatorTitle":[{"kind":"identifier","text":"levelerCropMode"}],"role":"symbol","fragments":[{"kind":"identifier","text":"levelerCropMode"}]},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/horizonsdk\/hvtcamera\/levelercropmode"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":") "},{"kind":"typeIdentifier","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTLevelerCropMode","preciseIdentifier":"c:@E@HVTLevelerCropMode","text":"HVTLevelerCropMode"},{"kind":"text","text":" "},{"kind":"identifier","text":"levelerCropMode"},{"kind":"text","text":";"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The leveler crops each video frame so that the resulting frame is leveled.  This involves rotating"},{"type":"text","text":" "},{"type":"text","text":"and scaling the crop region, prior to cropping the frame, according to the device’s physical"},{"type":"text","text":" "},{"type":"text","text":"orientation at that time. The crop mode is the way the leveler adjusts the rotation and scale of"},{"type":"text","text":" "},{"type":"text","text":"the crop region."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Note that scaling the crop region equals to zooming in the original video frame."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The property is animated."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The default value is "},{"code":"HVTLevelerCropModeFlex","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"symbol","abstract":[{"type":"text","text":"Specifies which crop mode will be used by the leveler."}],"references":{"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTLevelerCropMode":{"url":"\/documentation\/horizonsdk\/hvtlevelercropmode","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTLevelerCropMode","type":"topic","role":"symbol","fragments":[{"kind":"identifier","text":"HVTLevelerCropMode"}],"abstract":[{"type":"text","text":"Constants indicating the way the leveling algorithm adjusts the crop region according"},{"type":"text","text":" "},{"type":"text","text":"to the device’s physical orientation."}],"title":"HVTLevelerCropMode","kind":"symbol"},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK":{"url":"\/documentation\/horizonsdk","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","type":"topic","role":"collection","abstract":[{"type":"text","text":"Record leveled video and take leveled photos: horizontal no matter how the device is held."}],"title":"HorizonSDK","kind":"symbol"},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCamera/levelerCropMode":{"url":"\/documentation\/horizonsdk\/hvtcamera\/levelercropmode","type":"topic","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera\/levelerCropMode","role":"symbol","fragments":[{"text":"levelerCropMode","kind":"identifier"}],"abstract":[{"type":"text","text":"Specifies which crop mode will be used by the leveler."}],"title":"levelerCropMode","kind":"symbol"},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCamera":{"url":"\/documentation\/horizonsdk\/hvtcamera","role":"symbol","abstract":[{"type":"text","text":"You can use a HVTCamera object to establish a connection with the device camera, update the attached preview(s)"},{"type":"text","text":" "},{"type":"text","text":"and record to an audio\/video container file."}],"title":"HVTCamera","fragments":[{"kind":"identifier","text":"HVTCamera"}],"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera","type":"topic","kind":"symbol"}}}