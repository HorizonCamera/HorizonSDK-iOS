{"sections":[],"hierarchy":{"paths":[["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera\/startRunningWithCompletion:","interfaceLanguage":"occ"},"metadata":{"roleHeading":"Instance Method","externalID":"c:objc(cs)HVTCamera(im)startRunningWithCompletion:","symbolKind":"method","modules":[{"name":"HorizonSDK"}],"title":"startRunningWithCompletion:","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"startRunningWithCompletion:","kind":"identifier"}],"role":"symbol","fragments":[{"kind":"text","text":"- "},{"kind":"identifier","text":"startRunningWithCompletion:"}]},"variants":[{"paths":["\/documentation\/horizonsdk\/hvtcamera\/startrunningwithcompletion:"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"kind":"text","text":"- ("},{"preciseIdentifier":"c:v","kind":"typeIdentifier","text":"void"},{"kind":"text","text":") "},{"kind":"identifier","text":"startRunningWithCompletion:"},{"kind":"text","text":"("},{"preciseIdentifier":"c:v","kind":"typeIdentifier","text":"void"},{"kind":"text","text":" (^)("},{"preciseIdentifier":"c:objc(cs)NSError","kind":"typeIdentifier","text":"NSError"},{"kind":"text","text":" *"},{"kind":"internalParam","text":"error"},{"kind":"text","text":")) "},{"kind":"internalParam","text":"completion"},{"kind":"text","text":";"}]}],"kind":"declarations"},{"parameters":[{"name":"completion","content":[{"inlineContent":[{"text":"Called on the main queue; error is nil once running.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns at once; the session is configured and started off the main thread. The completion runs on the main"},{"type":"text","text":" "},{"type":"text","text":"queue once the session runs, or with an error: HVTErrorCameraNotAuthorized when camera access is not granted,"},{"type":"text","text":" "},{"type":"text","text":"HVTErrorCaptureDeviceNotProvided when there is no camera (e.g. the simulator), or the reason setup failed."},{"type":"text","text":" "},{"type":"text","text":"Unlike startRunning, nothing is thrown. A start requested while one is pending completes with it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Frames arrive shortly after the completion: [HVTCameraDelegate hvtCameraDidStartRunning:] still reports the"},{"type":"text","text":" "},{"type":"text","text":"first ones. While the start is pending the receiver isRunning, so a camera change or stopRunning issued"},{"type":"text","text":" "},{"type":"text","text":"meanwhile takes effect after it."}]}],"kind":"content"}],"kind":"symbol","abstract":[{"text":"Starts the flow of data from the camera device without blocking.","type":"text"}],"references":{"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCamera":{"url":"\/documentation\/horizonsdk\/hvtcamera","role":"symbol","abstract":[{"type":"text","text":"You can use a HVTCamera object to establish a connection with the device camera, update the attached preview(s)"},{"type":"text","text":" "},{"type":"text","text":"and record to an audio\/video container file."}],"title":"HVTCamera","fragments":[{"kind":"identifier","text":"HVTCamera"}],"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera","type":"topic","kind":"symbol"},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCamera/startRunningWithCompletion:":{"url":"\/documentation\/horizonsdk\/hvtcamera\/startrunningwithcompletion:","title":"startRunningWithCompletion:","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera\/startRunningWithCompletion:","type":"topic","role":"symbol","kind":"symbol","abstract":[{"text":"Starts the flow of data from the camera device without blocking.","type":"text"}],"fragments":[{"text":"- ","kind":"text"},{"text":"startRunningWithCompletion:","kind":"identifier"}]},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK":{"url":"\/documentation\/horizonsdk","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","type":"topic","role":"collection","abstract":[{"type":"text","text":"Record leveled video and take leveled photos: horizontal no matter how the device is held."}],"title":"HorizonSDK","kind":"symbol"}}}