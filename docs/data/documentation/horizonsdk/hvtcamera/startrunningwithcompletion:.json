{"hierarchy":{"paths":[["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera\/startRunningWithCompletion:","interfaceLanguage":"occ"},"metadata":{"fragments":[{"text":"- ","kind":"text"},{"text":"startRunningWithCompletion:","kind":"identifier"}],"modules":[{"name":"HorizonSDK"}],"roleHeading":"Instance Method","externalID":"c:objc(cs)HVTCamera(im)startRunningWithCompletion:","title":"startRunningWithCompletion:","role":"symbol","symbolKind":"method","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"startRunningWithCompletion:","kind":"identifier"}]},"abstract":[{"text":"Starts the flow of data from the camera device without blocking.","type":"text"}],"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"text":"- (","kind":"text"},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"text":"startRunningWithCompletion:","kind":"identifier"},{"text":"(","kind":"text"},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":" (^)(","kind":"text"},{"text":"NSError","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSError"},{"text":" *","kind":"text"},{"text":"error","kind":"internalParam"},{"text":")) ","kind":"text"},{"text":"completion","kind":"internalParam"},{"text":";","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"completion","content":[{"inlineContent":[{"text":"Called on the main queue; error is nil once running.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Returns at once; the session is configured and started off the main thread. The completion runs on the main","type":"text"},{"text":" ","type":"text"},{"text":"queue once the session runs, or with an error: HVTErrorCameraNotAuthorized when camera access is not granted,","type":"text"},{"text":" ","type":"text"},{"text":"HVTErrorCaptureDeviceNotProvided when there is no camera (e.g. the simulator), or the reason setup failed.","type":"text"},{"text":" ","type":"text"},{"text":"Unlike startRunning, nothing is thrown. A start requested while one is pending completes with it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Frames arrive shortly after the completion: [HVTCameraDelegate hvtCameraDidStartRunning:] still reports the","type":"text"},{"text":" ","type":"text"},{"text":"first ones. While the start is pending the receiver isRunning, so a camera change or stopRunning issued","type":"text"},{"text":" ","type":"text"},{"text":"meanwhile takes effect after it.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/horizonsdk\/hvtcamera\/startrunningwithcompletion:"]}],"references":{"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCamera":{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera","kind":"symbol","title":"HVTCamera","abstract":[{"text":"You can use a HVTCamera object to establish a connection with the device camera, update the attached preview(s)","type":"text"},{"text":" ","type":"text"},{"text":"and record to an audio\/video container file.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/horizonsdk\/hvtcamera","fragments":[{"kind":"identifier","text":"HVTCamera"}]},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCamera/startRunningWithCompletion:":{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera\/startRunningWithCompletion:","kind":"symbol","title":"startRunningWithCompletion:","abstract":[{"type":"text","text":"Starts the flow of data from the camera device without blocking."}],"type":"topic","role":"symbol","url":"\/documentation\/horizonsdk\/hvtcamera\/startrunningwithcompletion:","fragments":[{"text":"- ","kind":"text"},{"text":"startRunningWithCompletion:","kind":"identifier"}]},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK":{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","role":"collection","abstract":[{"text":"Record leveled video and take leveled photos: horizontal no matter how the device is held.","type":"text"}],"type":"topic","title":"HorizonSDK","url":"\/documentation\/horizonsdk","kind":"symbol"}}}