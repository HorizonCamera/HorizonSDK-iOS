{"hierarchy":{"paths":[["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera\/outputMovieSize"},"metadata":{"fragments":[{"text":"outputMovieSize","kind":"identifier"}],"modules":[{"name":"HorizonSDK"}],"roleHeading":"Instance Property","externalID":"c:objc(cs)HVTCamera(py)outputMovieSize","role":"symbol","title":"outputMovieSize","symbolKind":"property","navigatorTitle":[{"text":"outputMovieSize","kind":"identifier"}]},"abstract":[{"text":"Specifies the output movie size of the final video file.","type":"text"}],"sections":[],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["occ"],"tokens":[{"text":"@property","kind":"keyword"},{"text":" (","kind":"text"},{"text":"nonatomic","kind":"keyword"},{"text":") ","kind":"text"},{"text":"CGSize","kind":"typeIdentifier","preciseIdentifier":"c:@S@CGSize"},{"text":" ","kind":"text"},{"text":"outputMovieSize","kind":"identifier"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The outputMovieSize can differ from the cameraResolution. For example, you can have a 1920x1080"},{"type":"text","text":" "},{"type":"text","text":"camera resolution and a 640x640 final video file."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default value matches the cameraResolution, until set explicetely via this property."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"outputMovieSize cannot be set if the captureMode is set to HVTCaptureModePhoto."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"property has been successfully set or not."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is recommended that you call this property setter (or the "},{"type":"codeVoice","code":"setOutputMovieSize:error:"},{"type":"text","text":" "},{"type":"text","text":"method after setting up the resolution."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/horizonsdk\/hvtcamera\/outputmoviesize"]}],"references":{"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCamera/outputMovieSize":{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera\/outputMovieSize","kind":"symbol","title":"outputMovieSize","abstract":[{"type":"text","text":"Specifies the output movie size of the final video file."}],"type":"topic","role":"symbol","url":"\/documentation\/horizonsdk\/hvtcamera\/outputmoviesize","fragments":[{"text":"outputMovieSize","kind":"identifier"}]},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK":{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","role":"collection","abstract":[{"text":"Record leveled video and take leveled photos: horizontal no matter how the device is held.","type":"text"}],"type":"topic","title":"HorizonSDK","url":"\/documentation\/horizonsdk","kind":"symbol"},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCamera":{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera","kind":"symbol","title":"HVTCamera","abstract":[{"text":"You can use a HVTCamera object to establish a connection with the device camera, update the attached preview(s)","type":"text"},{"text":" ","type":"text"},{"text":"and record to an audio\/video container file.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/horizonsdk\/hvtcamera","fragments":[{"kind":"identifier","text":"HVTCamera"}]}}}