{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"text":") ","kind":"text"},{"kind":"typeIdentifier","text":"CGSize","preciseIdentifier":"c:@S@CGSize"},{"text":" ","kind":"text"},{"kind":"identifier","text":"outputMovieSize"},{"text":";","kind":"text"}],"languages":["occ"]}]},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The outputMovieSize can differ from the cameraResolution. For example, you can have a 1920x1080"},{"text":" ","type":"text"},{"text":"camera resolution and a 640x640 final video file.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The default value matches the cameraResolution, until set explicetely via this property."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"outputMovieSize cannot be set if the captureMode is set to HVTCaptureModePhoto.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"property has been successfully set or not.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It is recommended that you call this property setter (or the ","type":"text"},{"type":"codeVoice","code":"setOutputMovieSize:error:"},{"type":"text","text":" "},{"type":"text","text":"method after setting up the resolution."}]}],"kind":"content"}],"kind":"symbol","abstract":[{"text":"Specifies the output movie size of the final video file.","type":"text"}],"sections":[],"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera\/outputMovieSize"},"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/horizonsdk\/hvtcamera\/outputmoviesize"]}],"hierarchy":{"paths":[["doc:\/\/com.hvt.horizonsdk.framework\/docum