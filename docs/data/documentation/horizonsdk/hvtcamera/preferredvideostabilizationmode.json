{"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/horizonsdk\/hvtcamera\/preferredvideostabilizationmode"]}],"metadata":{"role":"symbol","roleHeading":"Instance Property","title":"preferredVideoStabilizationMode","modules":[{"name":"HorizonSDK"}],"externalID":"c:objc(cs)HVTCamera(py)preferredVideoStabilizationMode","symbolKind":"property","fragments":[{"kind":"identifier","text":"preferredVideoStabilizationMode"}],"navigatorTitle":[{"kind":"identifier","text":"preferredVideoStabilizationMode"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"@property"},{"kind":"text","text":" ("},{"kind":"keyword","text":"nonatomic"},{"kind":"text","text":") "},{"kind":"typeIdentifier","preciseIdentifier":"c:@E@AVCaptureVideoStabilizationMode","text":"AVCaptureVideoStabilizationMode"},{"kind":"text","text":" "},{"kind":"identifier","text":"preferredVideoStabilizationMode"},{"kind":"text","text":";"}],"languages":["occ"],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"This property is a wrapper of ","type":"text"},{"type":"codeVoice","code":"AVCaptureConnection"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"preferredVideoStabilizationMode"},{"text":" property for iOS8 devices.","type":"text"},{"text":" ","type":"text"},{"text":"In iOS7 devices, it sets ","type":"text"},{"type":"codeVoice","code":"AVCaptureConnection"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"setEnablesVideoStabilizationWhenAvailable"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"YES"},{"text":" when the","type":"text"},{"text":" ","type":"text"},{"text":"preferredVideoStablizationMode is anything but ","type":"text"},{"type":"codeVoice","code":"AVCaptureVideoStabilizationModeOff"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The default value is ","type":"text"},{"type":"codeVoice","code":"AVCaptureVideoStabilizationModeOff"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Stabilization smooths the camera’s roll as well as shake, so its picture turns later than the device. The leveler","type":"text"},{"text":" ","type":"text"},{"text":"straightens each frame by the device angle at the frame’s capture time, so with stabilization on, the leveled","type":"text"},{"text":" ","type":"text"},{"text":"horizon trails behind while the device rotates and catches up when it stops. Keep the default","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AVCaptureVideoStabilizationModeOff"},{"text":" for the best leveling.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"can take some time. The call will block until the connection has been established.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera\/preferredVideoStabilizationMode","interfaceLanguage":"occ"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Indicates the prefered stabilization mode to apply when supported by the current cameraDevice.","type":"text"}],"sections":[],"references":{"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCamera":{"title":"HVTCamera","abstract":[{"text":"You can use a HVTCamera object to establish a connection with the device camera, update the attached preview(s)","type":"text"},{"text":" ","type":"text"},{"text":"and record to an audio\/video container file.","type":"text"}],"type":"topic","url":"\/documentation\/horizonsdk\/hvtcamera","kind":"symbol","role":"symbol","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera","fragments