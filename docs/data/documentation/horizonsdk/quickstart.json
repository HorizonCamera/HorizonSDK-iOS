{"metadata":{"roleHeading":"Article","modules":[{"name":"HorizonSDK"}],"role":"article","title":"Quick Start"},"hierarchy":{"paths":[["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK"]]},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"After ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/Installation"},{"text":", choose between the ready-made ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraController"},{"text":" and building your","type":"text"},{"text":" ","type":"text"},{"text":"own interface around ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera"},{"type":"text","text":"."}]},{"text":"Use the camera controller","anchor":"Use-the-camera-controller","type":"heading","level":3},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraController"},{"type":"text","text":" works like "},{"type":"codeVoice","code":"UIImagePickerController"},{"type":"text","text":": present it, and receive the captured"},{"type":"text","text":" "},{"type":"text","text":"movie or photo in its delegate."}],"type":"paragraph"},{"syntax":"objc","type":"codeListing","code":["HVTCameraController *controller = [HVTCameraController new];","controller.allowedContentTypes = @[UTTypeMovie, UTTypeImage];","controller.cameraCaptureMode   = HVTCameraControllerCameraCaptureModeVideo;","controller.cameraDelegate      = self;","","[self presentViewController:controller animated:YES completion:nil];"]},{"inlineContent":[{"text":"Implement ","type":"text"},{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraControllerDelegate","isActive":true,"type":"reference"},{"text":" to handle the result or the user cancelling.","type":"text"}],"type":"paragraph"},{"text":"Build your own interface with HVTCamera","anchor":"Build-your-own-interface-with-HVTCamera","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a camera, attach a preview, and start it once camera access is granted:"}]},{"type":"codeListing","syntax":"objc","code":["HVTCamera *camera = [HVTCamera new];","camera.delegate = self;","","HVTView *preview = [[HVTView alloc] initWithFrame:self.view.bounds];","[self.view addSubview:preview];","[camera addView:preview];","","[camera startRunning];"]},{"type":"paragraph","inlineContent":[{"text":"Record to a file, choosing codec and container:","type":"text"}]},{"type":"codeListing","syntax":"objc","code":["NSURL *movieURL = [NSURL fileURLWithPath:[NSTemporaryDirectory() stringByAppendingPathComponent:@\"movie.mp4\"]];","","HVTRecordingConfiguration *configuration = [HVTRecordingConfiguration configurationWithMovieURL:movieURL];","configuration.codec    = AVVideoCodecTypeHEVC;","configuration.fileType = AVFileTypeMPEG4;","","NSError *error = nil;","","if (![camera startRecordingWithConfiguration:configuration error:&error]) {","    NSLog(@\"Cannot record: %@\", error);","}"]},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"type":"codeVoice","code":"stopRecording"},{"text":" to finish; the movie arrives in the delegate’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"hvtCamera:didStopRecordingWithMetadata:"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To take a photo, switch to photo mode and capture with ","type":"text"},{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTPhotoSettings","type":"reference","isActive":true},{"type":"text","text":"; the leveled"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTPhoto"},{"type":"text","text":" arrives in "},{"type":"codeVoice","code":"hvtCamera:didCapturePhoto:"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"objc","code":["camera.captureMode = HVTCaptureModePhoto;","","HVTPhotoSettings *settings = [HVTPhotoSettings photoSettings];","settings.codec = AVVideoCodecTypeHEVC;","","[camera capturePhotoWithSettings:settings];"]},{"type":"heading","anchor":"Choose-a-camera","level":3,"text":"Choose a camera"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera","type":"reference","isActive":true},{"type":"text","text":" lists every built-in camera, including ultra wide and telephoto lenses:"}]},{"type":"codeListing","syntax":"objc","code":["for (AVCaptureDevice *device in [HVTCamera availableDevices]) {","    NSLog(@\"%@ (%@)\", device.localizedName, device.deviceType);","}"]},{"type":"paragraph","inlineContent":[{"text":"Pick a device, find its format for a resolution and frame rate, and select both:","type":"text"}]},{"type":"codeListing","syntax":"objc","code":["AVCaptureDeviceFormat *format = [HVTCamera formatForDevice:device resolution:CGSizeMake(1920, 1080) frameRate:30];","NSError *error = nil;","","if (!format || ![camera setCaptureDevice:device format:format frameRate:30 error:&error]) {","    NSLog(@\"Cannot use 1080p30 on %@: %@\", device.localizedName, error);","}"]}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/QuickStart","interfaceLanguage":"occ"},"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"identifiers":["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/Installation","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTSDK"],"anchor":"Essentials","generated":true,"title":"Essentials"}],"variants":[{"paths":["\/documentation\/horiz