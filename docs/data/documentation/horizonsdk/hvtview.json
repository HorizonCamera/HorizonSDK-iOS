{"relationshipsSections":[{"identifiers":["doc:\/\/com.hvt.horizonsdk.framework\/objc(cs)UIView"],"title":"Inherits From","type":"inheritsFrom","kind":"relationships"}],"kind":"symbol","abstract":[{"type":"text","text":"HVTView is a subclass of UIView that you use to preview video as it is being captured by HVTCamera."}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraDelegate","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTBufferDelegate"],"anchor":"Camera","title":"Camera","generated":true}],"metadata":{"modules":[{"name":"HorizonSDK"}],"navigatorTitle":[{"kind":"identifier","text":"HVTView"}],"roleHeading":"Class","role":"symbol","symbolKind":"class","fragments":[{"kind":"identifier","text":"HVTView"}],"title":"HVTView","externalID":"c:objc(cs)HVTView"},"identifier":{"url":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView","interfaceLanguage":"occ"},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"kind":"keyword","text":"@interface"},{"kind":"text","text":" "},{"kind":"identifier","text":"HVTView"},{"kind":"text","text":" : "},{"preciseIdentifier":"c:objc(cs)UIView","kind":"typeIdentifier","text":"UIView"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Being a subclass of UIKit’s UIView, it inherits all the properties of this class and"},{"type":"text","text":" "},{"type":"text","text":"extends its functionality. You can create an HVTView by using the Interface Builder (and setting the"},{"type":"text","text":" "},{"type":"text","text":"class property to HVTView) or by instantiating it programmatically with initWithCoder: and"},{"type":"text","text":" "},{"type":"text","text":"initWithFrame: methods."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You use this view in conjunction with an HVTCamera instance, as illustrated in the following code fragment:"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"HVTcamera *camera = [HVTcamera new];"},{"type":"text","text":" "},{"type":"text","text":"HVTView *view = \/\/ an instance of HVTView created programmatically or in the Interface Builder"},{"type":"text","text":" "},{"type":"text","text":"[camera addView:view];"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The view’s orientation is derived by the HVTCamera it is attached to. So, make sure the [HVTCamera interfaceOrientation] property"},{"type":"text","text":" "},{"type":"text","text":"matches your app’s interface orientation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use the fillMode property to influence how the video preview is displayed relative to the view’s bounds."},{"type":"text","text":" "},{"type":"text","text":"You can use the showHUD property if you want the crop region to be displayed or not."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/horizonsdk\/hvtview"],"traits":[{"interfaceLanguage":"occ"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK"]]},"topicSections":[{"identifiers":["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/cropRegionTintColor","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/enabled","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/enablesDoubleTapToChangeFillMode","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/enablesLongPressToLockFocusExposure","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/enablesTapToFocus","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/fillMode","d