y the HVTCamera it is attached to. So, make sure the [HVTCamera interfaceOrientation] property"},{"type":"text","text":" "},{"type":"text","text":"matches your app’s interface orientation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can use the fillMode property to influence how the video preview is displayed relative to the view’s bounds."},{"type":"text","text":" "},{"type":"text","text":"You can use the showHUD property if you want the crop region to be displayed or not."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/horizonsdk\/hvtview"]}],"references":{"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTView/enablesTapToFocus":{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/enablesTapToFocus","kind":"symbol","title":"enablesTapToFocus","abstract":[{"type":"text","text":"Controls if the view will include a tap to focus gesture."}],"type":"topic","role":"symbol","url":"\/documentation\/horizonsdk\/hvtview\/enablestaptofocus","fragments":[{"text":"enablesTapToFocus","kind":"identifier"}]},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK":{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","role":"collection","abstract":[{"text":"Record leveled video and take leveled photos: horizontal no matter how the device is held.","type":"text"}],"type":"topic","title":"HorizonSDK","url":"\/documentation\/horizonsdk","kind":"symbol"},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCamera":{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera","kind":"symbol","title":"HVTCamera","abstract":[{"text":"You can use a HVTCamera object to establish a connection with the device camera, update the attached preview(s)","type":"text"},{"text":" ","type":"text"},{"text":"and record to an audio\/video container file.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentati