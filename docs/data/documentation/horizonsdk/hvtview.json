{"relationshipsSections":[{"title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/com.hvt.horizonsdk.framework\/objc(cs)UIView"],"type":"inheritsFrom"}],"hierarchy":{"paths":[["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView"},"metadata":{"fragments":[{"text":"HVTView","kind":"identifier"}],"modules":[{"name":"HorizonSDK"}],"roleHeading":"Class","externalID":"c:objc(cs)HVTView","role":"symbol","title":"HVTView","symbolKind":"class","navigatorTitle":[{"text":"HVTView","kind":"identifier"}]},"abstract":[{"text":"HVTView is a subclass of UIView that you use to preview video as it is being captured by HVTCamera.","type":"text"}],"sections":[],"kind":"symbol","topicSections":[{"title":"Instance Properties","identifiers":["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/cropRegionTintColor","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/enabled","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/enablesDoubleTapToChangeFillMode","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/enablesLongPressToLockFocusExposure","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/enablesTapToFocus","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/fillMode","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/filter","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/focusViewBorderWidth","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/focusViewColor","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/showHUD","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTView\/viewType","doc:\/\/com.hvt.horizonsdk.framework\/documentati