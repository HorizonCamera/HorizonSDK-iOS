{"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/com.hvt.horizonsdk.framework\/objc(pl)NSObject"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK"]]},"identifier":{"url":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraControllerDelegate","interfaceLanguage":"occ"},"metadata":{"fragments":[{"text":"HVTCameraControllerDelegate","kind":"identifier"}],"modules":[{"name":"HorizonSDK"}],"roleHeading":"Protocol","externalID":"c:objc(pl)HVTCameraControllerDelegate","title":"HVTCameraControllerDelegate","role":"symbol","symbolKind":"protocol","navigatorTitle":[{"text":"HVTCameraControllerDelegate","kind":"identifier"}]},"abstract":[{"text":"The HVTCameraControllerDelegate protocol defines methods that your delegate object must implement to interact with the camera controller interface. The methods of this protocol notify your delegate when the user either finishes capturing an image or movie, or cancels the camera operation.","type":"text"}],"sections":[],"kind":"symbol","topicSections":[{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraControllerDelegate\/cameraController:didFinishCapturingMediaWithInfo:","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraControllerDelegate\/cameraControllerDidCancel:"]}],"seeAlsoSections":[{"generated":true,"anchor":"Ready-made-interface","title":"Ready-made interface","identifiers":["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraController"]}],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["occ"],"tokens":[{"text":"@protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HVTCameraControllerDelegate","kind":"identifier"},{"text":" <","kind":"text"},{"text":"NSObject","kind":"typeIdentifier","preciseIdentifier":"c:objc(pl)NSObject"},{"text":">","kind":"text"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/QuickStart"]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"The delegate methods are responsible for dismissing the picker when the operation completes. To dismiss the picker, call the dismissModalViewControllerAnimated:completion: method of the parent controller responsible for displaying the HVTCameraController object."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To save a still image to the user’s Camera Roll album, call the UIImageWriteToSavedPhotosAlbum function from within the body of the cameraController:didFinishCapturingMediaWithInfo: method. To save a movie to the user’s Camera Roll album, instead call the UISaveVideoAtPathToSavedPhotosAlbum function. These functions, described in UIKit Function Reference, save the image or movie only; they do not save metadata."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To write additional metadata when saving an image to the Camera Roll, use the PHAssetChangeRequest class from the Photos framework. See the description for the HVTCameraControllerMediaMetadata key."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/horizonsdk\/hvtcameracontrollerdelegate"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCameraControllerDelegate/cameraControllerDidCancel:":{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraControllerDelegate\/cameraControllerDidCancel:","kind":"symbol","title":"cameraControllerDidCancel:","abstract":[{"text":"Tells the delegate that the user cancelled the pick operation.","type":"text"}],"type":"topic","role":