{"variants":[{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/horizonsdk\/hvtcameradelegate\/hvtcamera:didupdateparams:"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"fragments":[{"text":"- ","kind":"text"},{"text":"hvtCamera:didUpdateParams:","kind":"identifier"}],"externalID":"c:objc(pl)HVTCameraDelegate(im)hvtCamera:didUpdateParams:","symbolKind":"method","role":"symbol","roleHeading":"Instance Method","navigatorTitle":[{"text":"- ","kind":"text"},{"text":"hvtCamera:didUpdateParams:","kind":"identifier"}],"title":"hvtCamera:didUpdateParams:","modules":[{"name":"HorizonSDK"}]},"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["occ"],"tokens":[{"text":"- (","kind":"text"},{"text":"void","kind":"typeIdentifier","preciseIdentifier":"c:v"},{"text":") ","kind":"text"},{"text":"hvtCamera:","kind":"identifier"},{"text":"(","kind":"text"},{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCamera","text":"HVTCamera","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)HVTCamera"},{"text":" *) ","kind":"text"},{"text":"hvtCamera","kind":"internalParam"},{"text":" ","kind":"text"},{"text":"didUpdateParams:","kind":"identifier"},{"text":"(","kind":"text"},{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTParams","text":"HVTParams","kind":"typeIdentifier","preciseIdentifier":"c:@SA@HVTParams"},{"text":") ","kind":"text"},{"text":"params","kind":"internalParam"},{"text":";","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"hvtCamera","content":[{"inlineContent":[{"type":"text","text":"The HVTCamera object calling the delegate method."}],"type":"paragraph"}]},{"name":"params","content":[{"inlineContent":[{"type":"text","text":"The angle (physical yaw) of the device in rads and scale values."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The angle represents the yaw of the device (in the real world) at the time the","type":"text"},{"text":" ","type":"text"},{"text":"latest video frame was received by the device’s camera.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The scale represents the scale that has to be applied to the frame depending on the active levelerCropMode","type":"text"},{"text":" ","type":"text"},{"text":"and the angle of the device.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You may want to rotate your UI elements to match the attached HVTView(s) appearence","type":"text"},{"text":" ","type":"text"},{"text":"as illustrated in the following code fragment:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"(void)hvtCamera:(HVTCamera *)hvtCamera didUpdateParams:(HVTParams)params"},{"type":"text","text":" "},{"type":"text","text":"{"},{"type":"text","text":" "},{"type":"text","text":"[_uiElement setTransform:CGAffineTransformMakeRotation(params.angle)];"},{"type":"text","text":" "},{"type":"text","text":"}"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The calling frequency matches the frame rate of the HVTCamera instance.","type":"text"}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK","doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraDelegate"]]},"identifier":{"interfaceLanguage":"occ","url":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraDelegate\/hvtCamera:didUpdateParams:"},"abstract":[{"text":"Implement this method to be notified of the updated device angle and computed scale factors in order to","type":"text"},{"text":" ","type":"text"},{"text":"adjust your interface elements (i.e. rotate your UI elements).","type":"text"}],"references":{"doc://com.hvt.horizonsdk.framewo