ion\/horizonsdk","kind":"symbol"},"doc://com.hvt.horizonsdk.framework/documentation/HorizonSDK/HVTCameraDelegate":{"identifier":"doc:\/\/com.hvt.horizonsdk.framework\/documentation\/HorizonSDK\/HVTCameraDelegate","kind":"symbol","title":"HVTCameraDelegate","abstract":[{"text":"The HVTCameraDelegate protocol defines delegate methods you should implement in order","type":"text"},{"text":" ","type":"text"},{"text":"to get updates from an HVTCamera instance about the running state, recording status, handle errors and update the UI.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/horizonsdk\/hvtcameradelegate","fragments":[{"kind":"identifier","text":"HVTCameraDelegate"}]}}}